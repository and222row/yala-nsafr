# App
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# Database (PostgreSQL + PostGIS)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=yala_nsafr
DB_USER=yala_user
DB_PASS=yala_pass

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=30d

# OTP SMS provider — options: stub | twilio | vonage
# Phone numbers must be in E.164 format (+20XXXXXXXXXX for Egypt)
SMS_PROVIDER=stub

# Twilio (https://console.twilio.com)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Vonage / Nexmo (https://dashboard.nexmo.com) — alternative to Twilio
VONAGE_API_KEY=
VONAGE_API_SECRET=
VONAGE_FROM=YalaNsafr

# Firebase Cloud Messaging (push notifications)
FCM_PROJECT_ID=
FCM_PRIVATE_KEY=
FCM_CLIENT_EMAIL=

# Payments — Kashier
# Get these from https://portal.kashier.io/en/dashboard/integration
KASHIER_MERCHANT_ID=MID-XXXXX-X
KASHIER_API_KEY=
KASHIER_SECRET_KEY=

# Payments — Paymob (legacy, keep if you switch back)
# PAYMOB_API_KEY=
# PAYMOB_INTEGRATION_ID_CARD=
# PAYMOB_INTEGRATION_ID_WALLET=
# PAYMOB_HMAC_SECRET=
# PAYMOB_IFRAME_ID=

# Commission
DEFAULT_COMMISSION_RATE=0.07

# Google Maps
GOOGLE_MAPS_API_KEY=
